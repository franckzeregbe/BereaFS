PORT=3000
NODE_ENV=development
# Obligatoire en production : au moins 32 caractères aléatoires
# (ex. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Relatif à la racine du projet
DB_PATH=./server/bereafs.db
# Liste séparée par des virgules en production, ex. https://bereafs.com
CORS_ORIGIN=*
# Mettre 1 derrière un reverse proxy (nginx, Render, Railway...)
TRUST_PROXY=
LOG_LEVEL=info
